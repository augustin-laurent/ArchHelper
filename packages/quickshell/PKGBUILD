# First-release runtime, pinned to the audited RC sources.
# Adapted from the pinned Omarchy RC recipe; Qt packages remain upstream.
pkgname=v8-quickshell
pkgver=0.3.2.r7.g2b4501a
pkgrel=1
pkgdesc='Flexible toolkit for making desktop shells with QtQuick'
arch=(x86_64 aarch64)
url='https://github.com/quickshell-mirror/quickshell'
license=(LGPL-3.0-only)
depends=(
  cpptrace
  glibc
  hicolor-icon-theme
  jemalloc
  libdrm
  libgcc
  libglvnd
  libpipewire
  libstdc++
  libxcb
  mesa
  pam
  polkit
  qt6-base
  qt6-declarative
  qt6-svg
  qt6-wayland
  wayland
)
makedepends=(
  cli11
  cmake
  git
  ninja
  qt6-shadertools
  spirv-tools
  vulkan-headers
  wayland-protocols
)
provides=("quickshell=${pkgver}")
conflicts=(quickshell quickshell-git)
# master past v0.3.2; the upstream watch writes the tag's commit here when
# the next release lands.
_commit=2b4501a282689792b62e94f3fb30d8f512324fe6
_archive=quickshell
source=("$_archive::git+$url.git#commit=$_commit"
        load_qtquick_611.patch
        v8-quickshell-check.hook)
sha256sums=('SKIP'
            '23b65d205d825f11a1cd8501acbc6e50250d09a6ce607e2ff8b3cf5d438bd0ce'
            'd02da428ae72ca6bec2bf1be224674b39aaf7ddbff03d8c09a2f1eb81bd1cbdb')

prepare() {
  cd "$_archive"
  patch -Np1 --fuzz=0 -i "$srcdir/load_qtquick_611.patch"
}

build() {
  cd "$_archive"
  cmake -G Ninja -B build -W no-dev \
    -D CMAKE_BUILD_TYPE=RelWithDebInfo \
    -D DISTRIBUTOR='V8' \
    -D CRASH_REPORTER=Off \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D INSTALL_QML_PREFIX=lib/qt6/qml
  cmake --build build
}

package() {
  install -Dm644 v8-quickshell-check.hook -t "$pkgdir/usr/share/libalpm/hooks"
  cd "$_archive"
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
